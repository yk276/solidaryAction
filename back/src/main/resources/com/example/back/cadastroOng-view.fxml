<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="460.0" prefWidth="650.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.back.OngController">

    <children>

        <Label layoutX="40.0" layoutY="65.0"
               text="Nome fantasia:" />
        <TextField fx:id="txtNomeFantasia"
                   layoutX="40.0" layoutY="88.0"
                   prefWidth="250.0" />

        <Label layoutX="40.0" layoutY="125.0"
               text="Razão social:" />
        <TextField fx:id="txtRazaoSocial"
                   layoutX="40.0" layoutY="148.0"
                   prefWidth="250.0" />

        <Label layoutX="40.0" layoutY="185.0"
               text="CNPJ:" />
        <TextField fx:id="txtCnpj"
                   layoutX="40.0" layoutY="208.0"
                   prefWidth="250.0" />

        <Label layoutX="40.0" layoutY="245.0"
               text="Email da ONG:" />
        <TextField fx:id="txtEmail"
                   layoutX="40.0" layoutY="268.0"
                   prefWidth="250.0" />

        <Label layoutX="40.0" layoutY="305.0"
               text="Endereço:" />
        <TextField fx:id="txtEndereco"
                   layoutX="40.0" layoutY="328.0"
                   prefWidth="250.0" />

        <Label layoutX="350.0" layoutY="65.0"
               text="Nome completo:" />
        <TextField fx:id="txtNomeCoordenador"
                   layoutX="350.0" layoutY="88.0"
                   prefWidth="250.0" />

        <Label layoutX="350.0" layoutY="125.0"
               text="CPF:" />
        <TextField fx:id="txtCpfCoordenador"
                   layoutX="350.0" layoutY="148.0"
                   prefWidth="250.0" />

        <Label layoutX="350.0" layoutY="185.0"
               text="Email do coordenador:" />
        <TextField fx:id="txtEmailCoordenador"
                   layoutX="350.0" layoutY="208.0"
                   prefWidth="250.0" />

        <Label layoutX="350.0" layoutY="245.0"
               text="Senha do coordenador:" />
        <PasswordField fx:id="txtSenhaCoordenador"
                       layoutX="350.0" layoutY="268.0"
                       prefWidth="250.0" />

        <Button layoutX="40.0" layoutY="405.0"
                mnemonicParsing="false"
                onAction="#onVoltarAoMenu"
                text="Voltar" />

        <Button layoutX="540.0" layoutY="405.0"
                mnemonicParsing="false"
                onAction="#salvarOng"
                text="Salvar" />

    </children>
</AnchorPane>